---
/**
 * /rent-vs-buy/: the Rent v buy calculator (it was the home page until the home page became the
 * list of calculators), then the four nations, each with its number of areas, typical price and rent and the
 * middle break-even year at typical assumptions, linking to the nation pages.
 */
import Base from '../../layouts/Base.astro';
import CalculatorIsland from '../../components/calculator/CalculatorIsland';
import { calculatorLinks, calculatorPreloads } from '../../lib/calculator-data';
import { monthLabel } from '../../lib/area-summary';
import {
  nationFigures,
  nationOverview,
  nationsIndexPath,
  typicalAssumptions,
} from '../../lib/areas';
import { TOOL_OG, absoluteUrl, breadcrumbLd, webApplicationLd } from '../../lib/seo';
import { url } from '../../lib/url';
import '../../styles/area.css';

const site = Astro.site ?? Astro.url;
const description =
  'Rent v buy: how long until buying beats renting? A plain-English UK calculator that starts from local figures, for every local authority.';
const jsonLd = [
  webApplicationLd({
    name: 'House Sums: Rent v buy',
    url: absoluteUrl(nationsIndexPath(), site),
    description,
  }),
  breadcrumbLd([
    { name: 'House Sums', url: absoluteUrl(url(), site) },
    { name: 'Rent v buy', url: absoluteUrl(nationsIndexPath(), site) },
  ]),
];
const rows = nationOverview();
const total = rows.reduce((sum, row) => sum + row.count, 0);
const england = nationFigures('eng').months;
const ni = nationFigures('ni').months;
---

<Base
  title="Rent v buy"
  description={description}
  jsonLd={jsonLd}
  preloads={calculatorPreloads()}
  ogImage={TOOL_OG['rent-v-buy'].path}
  ogImageAlt={TOOL_OG['rent-v-buy'].alt}
>
  <h1 class="calc-title">Rent v buy: how long until buying beats renting?</h1>
  <script is:inline>
    if (/[?&]a=[^&]/.test(location.search)) document.documentElement.dataset.calcLink = '';
  </script>
  <CalculatorIsland client:load links={calculatorLinks()} />
  <h2 class="area-title area-title--section" id="by-nation">
    Rent v buy by nation
  </h2>
  <p class="area-lede">
    {total} local authorities across the four nations, each with its own page. Pick a nation for its
    areas, figures and property tax.
  </p>
  <div class="area-stack">
    <div>
      <table class="data-table area-table" data-testid="nations">
        <caption class="data-table__caption visually-hidden">The four nations</caption>
        <thead>
          <tr>
            <th scope="col">Nation</th>
            <th scope="col" class="data-table__num">
              Areas
            </th>
            <th scope="col" class="data-table__num">
              Average price
            </th>
            <th scope="col" class="data-table__num">
              Rent a month
            </th>
            <th scope="col" class="data-table__num area-table__answer">
              Middle break-even
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row" class="area-table__name">
                <a href={row.href}>{row.name}</a>
              </th>
              <td class="data-table__num">{row.count}</td>
              <td class="data-table__num">{row.price}</td>
              <td class="data-table__num">{row.rent}</td>
              <td class="data-table__num area-table__answer">{row.middle}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="area-stack area-stack--tight">
      <p class="area-note">
        Prices for {monthLabel(england.price)} and rents for {monthLabel(england.rent)} (Northern
        Ireland: prices for {monthLabel(ni.price)}, rents for {monthLabel(ni.rent)}). The middle
        break-even is the middle of each area's answer at typical assumptions.
      </p>
      <p class="area-note">{typicalAssumptions()}</p>
    </div>
  </div>
</Base>

<style>
  .calc-title {
    margin-block: var(--space-2) var(--space-5);
  }

  .area-title--section {
    margin-top: var(--space-12);
  }
</style>
