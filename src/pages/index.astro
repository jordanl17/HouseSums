---
/**
 * Home: the calculators, one card each. Rent v buy lives at /rent-vs-buy/ (above the nations
 * table) and Sell later at /sell-later/. No JavaScript.
 */
import Base from '../layouts/Base.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { nationsIndexPath } from '../lib/areas';
import { url } from '../lib/url';
import '../styles/home.css';

const tools = [
  {
    kind: 'rent-v-buy',
    href: nationsIndexPath(),
    title: 'Rent v buy',
    text: 'How long until buying beats renting, starting from local prices and rents.',
  },
  {
    kind: 'sell-later',
    href: url('sell-later'),
    title: 'Sell later',
    text: 'Buy now, sell in a few years: what you get back once the mortgage is cleared.',
  },
] as const;
---

<Base description="House Sums: plain-English UK home-buying calculators that start from real figures.">
  <h1 class="home-title">UK home-buying calculators</h1>
  <ul class="tools" data-testid="tools">
    {tools.map((tool) => (
      <li>
        <a class="card tool-card" href={tool.href} data-testid={`tool-${tool.kind}`}>
          <ToolIcon kind={tool.kind} />
          <h2 class="tool-card__title">{tool.title}</h2>
          <p class="tool-card__text">{tool.text}</p>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .home-title {
    margin-block: var(--space-2) var(--space-5);
  }
</style>
