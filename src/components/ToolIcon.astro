---
/**
 * Calculator icons for the home page cards, in the logo's style: a 24-unit grid, whole-unit ink
 * strokes, one hi-vis accent with an ink edge, data colours only where they mean data.
 *
 * - rent-v-buy: a house with the chart inside it, the buy line (blue) rising across the rent
 *   line (orange), and the hi-vis break-even dot where they cross.
 * - sell-later: an estate agent's board on its post, hi-vis with an ink edge and an ink arrow
 *   up, by the ground line.
 *
 * Decorative (aria-hidden): the card's heading names the calculator. Colours come from tokens
 * through classes in src/styles/home.css.
 */
interface Props {
  kind: 'rent-v-buy' | 'sell-later';
  /** Height in px. Default 48. */
  size?: number;
}

const { kind, size = 48 } = Astro.props;
---

<svg
  class="tool-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  {kind === 'rent-v-buy' ? (
    <>
      <path class="tool-icon__ink" d="M2.5 11 12 3l9.5 8" />
      <path class="tool-icon__ink" d="M5 9.5V21h14V9.5" />
      <path class="tool-icon__rent" d="M7.5 13.5 16.5 18.5" />
      <path class="tool-icon__buy" d="M7.5 18.5 16.5 13.5" />
      <circle class="tool-icon__hi-vis" cx="12" cy="16" r="2" />
    </>
  ) : (
    <>
      <path class="tool-icon__ink" d="M2 21h20" />
      <path class="tool-icon__ink" d="M6 21V3M6 5h13" />
      <path class="tool-icon__ink tool-icon__thin" d="M10 5v3M18 5v3" />
      <rect class="tool-icon__hi-vis" x="8.5" y="8" width="11" height="8" rx="1" />
      <path class="tool-icon__on-hi-vis tool-icon__thin" d="M11.5 13.5 14 11l2.5 2.5M14 11v3.5" />
    </>
  )}
</svg>
