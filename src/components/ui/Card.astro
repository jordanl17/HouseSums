---
/** Plain surface. Styles in src/styles/ui/ (global classes, reused by phase 4 Preact). */
import type { CardProps } from './types';

type Props = CardProps;
const { as: Tag = 'div', labelledby, class: className } = Astro.props;
---

<Tag class:list={['card', className]} aria-labelledby={labelledby}>
  <slot />
</Tag>
