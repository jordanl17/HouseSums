---
/** Plain table: thin ink rules, right-aligned tabular numbers. Stub from the phase 2 lead; the primitives teammate owns it. */
import type { DataTableProps } from './types';

type Props = DataTableProps;
const { caption, captionHidden = false, columns, rows, class: className } = Astro.props;
---

<table class:list={['data-table', className]}>
  <caption class:list={['data-table__caption', { 'visually-hidden': captionHidden }]}>
    {caption}
  </caption>
  <thead>
    <tr>
      {columns.map((column) => (
        <th scope="col" class:list={{ 'data-table__num': column.numeric }}>
          {column.label}
        </th>
      ))}
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr>
        {columns.map((column) => (
          <td class:list={{ 'data-table__num': column.numeric }}>{row[column.key] ?? ''}</td>
        ))}
      </tr>
    ))}
  </tbody>
</table>
