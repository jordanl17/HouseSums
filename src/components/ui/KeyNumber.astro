---
/** Label, figure and unit. Place inside <dl class="key-numbers">. Stub from the phase 2 lead; the primitives teammate owns it. */
import type { KeyNumberProps } from './types';

type Props = KeyNumberProps;
const { label, value, unit, class: className } = Astro.props;
---

<div class:list={['key-number', className]}>
  <dt class="key-number__label">{label}</dt>
  <dd class="key-number__value">
    <span class="key-number__figure">{value}</span>
    {unit && <span class="key-number__unit">{unit}</span>}
  </dd>
</div>
