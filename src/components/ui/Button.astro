---
/** Pill button or link. Stub from the phase 2 lead; the primitives teammate owns it. */
import type { ButtonProps } from './types';

type Props = ButtonProps;
const {
  variant = 'primary',
  href,
  type = 'button',
  disabled = false,
  class: className,
} = Astro.props;
const classes = ['button', `button--${variant}`, className];
---

{href ? (
  <a class:list={classes} href={href}>
    <slot />
  </a>
) : (
  <button class:list={classes} type={type} disabled={disabled}>
    <slot />
  </button>
)}
