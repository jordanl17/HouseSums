---
/**
 * Base page shell. The props are the contract; keep them.
 * Pages pass a plain title (e.g. "Sources"); the site name is added here.
 *
 * Stylesheet order matters and is part of the phase 2 contract: self-hosted fonts
 * (latin subset only, font-display swap) and the narrow mono punctuation (fonts.css), tokens,
 * base, UI primitives, page shell.
 *
 * Phase 6 (perf): the woff2 files are preloaded, so they download with the stylesheet rather
 * than after it (no late swap, no shift); `preloads` lets a page add its own (the calculator's
 * data file). Polish: every page preloads B612 400 and 700 and B612 Mono 400, which every page
 * uses; B612 Mono 700 (bold figures) only on pages that show it in the first screen
 * (`boldFigures`), so no page downloads a preloaded font it never uses.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/ui.css';
import '../styles/shell.css';
// Phase 6 (perf): the calculator's stylesheet joins the shared one (it was a second
// render-blocking request on the home and area pages). See "Performance (phase 6, perf)" in
// docs/decisions.md.
import '../styles/calculator.css';
// After the stylesheets: Astro orders a page's CSS by import order, and these imports first put
// Base's stylesheet after the pages' inline styles, which then lost to it.
import b612Regular from '@fontsource/b612/files/b612-latin-400-normal.woff2?url';
import b612Bold from '@fontsource/b612/files/b612-latin-700-normal.woff2?url';
import b612MonoRegular from '@fontsource/b612-mono/files/b612-mono-latin-400-normal.woff2?url';
import b612MonoBold from '@fontsource/b612-mono/files/b612-mono-latin-700-normal.woff2?url';
import Logo from '../components/Logo.astro';
import type { Preload } from '../lib/preload';
import { url } from '../lib/url';
import {
  DEFAULT_DESCRIPTION,
  OG_IMAGE_SIZE,
  SITE_NAME,
  absoluteUrl,
  canonicalUrl,
  fullTitle as buildTitle,
  jsonLdText,
  ogImageAlt,
  ogImagePath,
  type JsonLd,
} from '../lib/seo';

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  /** Meta description. */
  description?: string;
  /** Exclude from search engines and skip the canonical link (e.g. the 404 page). */
  noindex?: boolean;
  /**
   * Phase 5, optional. Open Graph image as a site-relative path, from ogImagePath() in
   * src/lib/seo.ts (e.g. "og/scotland.png"). Defaults to the site card, "og/default.png".
   */
  ogImage?: string;
  /** Phase 5, optional. Alt text for ogImage; defaults to the site card's. */
  ogImageAlt?: string;
  /** Phase 5, optional. JSON-LD objects from the builders in src/lib/seo.ts. */
  jsonLd?: JsonLd | readonly JsonLd[];
  /**
   * Phase 6, optional. Extra <link rel="preload">s for this page, after the fonts (pages with
   * the calculator pass calculatorPreloads() from src/lib/calculator-data.ts).
   */
  preloads?: readonly Preload[] | undefined;
  /**
   * Optional. Also preload B612 Mono 700, for pages that show bold figures in the first screen:
   * the answer numeral on area pages, the refresh date on Sources. Default false.
   */
  boldFigures?: boolean;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  noindex = false,
  ogImage = ogImagePath(),
  ogImageAlt: imageAlt = ogImageAlt(),
  jsonLd,
  preloads = [],
  boldFigures = false,
} = Astro.props;
const fontPreloads: readonly Preload[] = [
  b612Regular,
  b612Bold,
  b612MonoRegular,
  ...(boldFigures ? [b612MonoBold] : []),
].map((href) => ({ href, as: 'font', type: 'font/woff2' }));
// Fetches and fonts are requested in CORS mode, so their preloads need crossorigin to be used.
const needsCors = (as: Preload['as']) => as === 'font' || as === 'fetch';
const fullTitle = buildTitle(title);
// Commit the build came from. The deploy workflow waits for this before testing the live site.
const buildSha = import.meta.env.PUBLIC_BUILD_SHA ?? 'dev';
const site = Astro.site ?? Astro.url;
const canonical = canonicalUrl(Astro.url.pathname, site);
const ogImageUrl = absoluteUrl(url(ogImage), site);
const ldBlocks = jsonLd === undefined ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];

// Header nav and footer links. Paths go through url() so they work under any base path.
const withSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const here = withSlash(Astro.url.pathname);
const nav = [
  { label: 'How it works', href: url('how-it-works') },
  { label: 'Sources', href: url('sources') },
];
const footerLinks = [
  { label: 'About', href: url('about') },
  { label: 'Sources', href: url('sources') },
];
const current = (href: string) => (withSlash(href) === here ? 'page' : undefined);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {[...fontPreloads, ...preloads].map((preload) => (
      <link
        rel="preload"
        href={preload.href}
        as={preload.as}
        type={preload.type}
        crossorigin={needsCors(preload.as) ? 'anonymous' : undefined}
      />
    ))}
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(OG_IMAGE_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE_SIZE.height)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {ldBlocks.map((block) => (
      <script is:inline type="application/ld+json" set:html={jsonLdText(block)} />
    ))}
    <meta name="hs-build" content={buildSha} />
    <!-- Never more than our origin in a Referer: links carry figures in the query string. -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  </head>
  <body class="site">
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__home" href={url()} aria-current={current(url())}>
          <Logo />
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul class="site-nav__list">
            {nav.map((item) => (
              <li>
                <a class="site-nav__link" href={item.href} aria-current={current(item.href)}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="site-main container" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__inner">
          <div class="site-footer__about">
            <p>This is a model, not financial advice.</p>
            <ul class="site-footer__links" aria-label="About this site">
              {footerLinks.map((item) => (
                <li>
                  <a class="site-footer__link" href={item.href} aria-current={current(item.href)}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <p class="site-footer__tagline">The maths of moving in.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
